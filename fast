#!/usr/bin/env bash
# Fast hybrid mode: keyword search + search by meaning, with cached embeddings. No Docker, no database.
# Usage: ./fast [folder] [options]      e.g.  ./fast ~/projects/my-app
#        ./fast ~/projects/my-app --prepare     (embed everything once, ahead of a demo)
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUT="$DIR/target/fast-classes"
SRC="$DIR/src/main/java/com/localrag/assistant/fast"
if [ ! -f "$OUT/com/localrag/assistant/fast/Main.class" ] || [ -n "$(find "$SRC" -newer "$OUT/com/localrag/assistant/fast/Main.class" -name '*.java' 2>/dev/null | head -1)" ]; then
  mkdir -p "$OUT"
  javac -d "$OUT" $(find "$SRC" -name '*.java') || exit 1
fi
exec java -cp "$OUT" com.localrag.assistant.fast.Main "${@:-.}"
